<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sign in with Apple ist auf iOS Pflicht, sobald ein zweiter Anbieter
	     da ist — App Store Review Guideline 4.8. Ohne diese Berechtigung
	     wirft `sign_in_with_apple` beim ersten Versuch einen Fehler, und
	     zwar erst auf dem Geraet, nie im Simulator. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
