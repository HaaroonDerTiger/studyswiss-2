<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptives Icon. Android beschneidet den Vordergrund je nach Gerät rund,
  quadratisch oder als Tropfen — deshalb liegt alles Wichtige im inneren
  Kreis mit 66 % Durchmesser. Die Vorlage dazu ist
  app/marke/android-vordergrund.svg.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
